<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.jarvis-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__INSTALL_DIR__/tts_watchdog.py</string>
        <string>--interval</string>
        <string>30</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__INSTALL_DIR__</string>

    <!-- Restart automatically if it exits for any reason -->
    <key>KeepAlive</key>
    <true/>

    <!-- Start at login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Throttle rapid restart loops (30s minimum between restarts) -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Log stdout/stderr -->
    <key>StandardOutPath</key>
    <string>__INSTALL_DIR__/watchdog.out</string>
    <key>StandardErrorPath</key>
    <string>__INSTALL_DIR__/watchdog.err</string>

    <!-- Low priority — don't compete with synthesis work -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>

    <!-- Environment -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
