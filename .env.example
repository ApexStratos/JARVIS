# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# ──────────────────────────────────────────────
#  VOICE ENGINES
# ──────────────────────────────────────────────

# [Fish Audio] Cloud voice cloning — all 27 custom voice clones, <1s latency
# Without this key, Fish voices fall back to macOS say (~0.5s, no clone character)
# Get key → https://fish.audio/go-api/
FISH_AUDIO_API_KEY=

# [ElevenLabs] Extra TTS voices
# Get key → https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ──────────────────────────────────────────────
#  TELEPHONY (CALL_ME — live two-way phone conversation)
# ──────────────────────────────────────────────

# [Twilio] Sign up at twilio.com, buy a phone number (~$1/mo)
# Account SID / Auth Token → https://console.twilio.com (dashboard home)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Your real phone number, in E.164 format (e.g. +15551234567) — CALL_ME dials this
MY_PHONE_NUMBER=
# Public HTTPS URL Twilio calls back on (e.g. a Cloudflare Tunnel to this
# Mac). Shared with glasses_mode_router.py's away-mode phone bridge — set
# once, used by both. Not yet configured on this machine (glasses BLE
# daemon isn't installed either) — CALL_ME fails closed with a clear error
# until this is set, rather than silently trying and failing later.
CLOUDFLARE_TUNNEL_URL=

# ──────────────────────────────────────────────
#  AI / LLM
# ──────────────────────────────────────────────

# [Claude] Used by the vision auto-agent always, and by the main brain when
# BRAIN_PROVIDER=anthropic (see APP CONFIG below)
# Get key → https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# [Groq] Optional faster LLM inference
# Get key → https://console.groq.com/keys
GROQ_API_KEY=

# ──────────────────────────────────────────────
#  TRADING
# ──────────────────────────────────────────────

# [Alpaca] Paper or live trading
# Get keys → https://alpaca.markets/
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ──────────────────────────────────────────────
#  INTEGRATIONS
# ──────────────────────────────────────────────

# [Spotify] Music control
# Get credentials → https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# [Telegram] Push notifications + remote control
# Create bot → https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# [MyMemory] Optional — any email raises the free TRANSLATE tool's rate
# limit from ~1000 to ~10000 requests/day. Not required.
TRANSLATE_CONTACT_EMAIL=

# [SMTP] Optional — the EMAIL tool uses this on any OS when set (Gmail,
# Outlook, your own mail server, etc). Without it, EMAIL falls back to
# macOS Mail.app via AppleScript (macOS only).
# Gmail example: smtp.gmail.com / 587 / your address / an App Password
# (not your regular password — console.google.com/apis → App Passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ──────────────────────────────────────────────
#  APP CONFIG
# ──────────────────────────────────────────────

FLASK_SECRET=change-me-to-a-random-string
JARVIS_PIN=1234

# [Ollama] Local LLM (no key needed — just install ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Which brain backend to use: "ollama" (free, local, default) or "anthropic"
# (Claude Haiku 4.5, needs ANTHROPIC_API_KEY above — a few dollars/month at
# normal use)
BRAIN_PROVIDER=ollama
ANTHROPIC_MODEL=claude-haiku-4-5

# Self-upgrade/self-heal commit locally but will NOT push to GitHub unless
# this is set — a misheard voice command can trigger SELF_UPGRADE/SELF_HEAL,
# and autonomous pushes to your real repo shouldn't be the default.
JARVIS_ALLOW_SELF_PUSH=0

# Off by default. When set to 1, a background thread checks disk usage every
# 10 minutes and automatically empties ~/.Trash and clears caches (Xcode
# DerivedData, pip cache, __pycache__, .DS_Store — see storage_manager.py)
# once usage crosses 80%/90%. No per-run confirmation — only turn this on if
# you're comfortable with that running unattended on this machine.
JARVIS_AUTO_STORAGE_CLEANUP=0

PORT=5001
